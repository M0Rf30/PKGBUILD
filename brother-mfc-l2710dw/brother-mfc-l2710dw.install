post_install() {
  post_upgrade;
}

post_upgrade() {
  echo 'Restart CUPS (systemctl restart cups.service) in order to load the new files.'
  echo 'Register the new printer at "http://localhost:631/".'
  echo
  echo '  To avoid errors like "Unable to locate printer..." when printing via network:'
  echo '  add the printer with its socket address "socket://<printer ip>:9100"'
}

