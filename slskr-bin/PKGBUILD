# Maintainer: robertfoster

pkgname=slskr-bin
pkgver=0.2.32 # renovate: datasource=github-releases depName=snapetech/slskr extractVersion=^release-v(?<version>.*)$
pkgrel=1
pkgdesc="Self-hosted Soulseek daemon, HTTP API, and browser UI written in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/snapetech/slskr"
license=('AGPL-3.0-only')
depends=('gcc-libs' 'glibc')
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
backup=("etc/${pkgname%-bin}/config.toml")

source=(
  "${pkgname%-bin}.service"
  "${pkgname%-bin}.sysusers"
  "${pkgname%-bin}.tmpfiles"
)
source_x86_64=("${pkgname%-bin}-${pkgver}-x86_64.tar.gz::${url}/releases/download/release-v${pkgver}/slskr-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${pkgname%-bin}-${pkgver}-aarch64.tar.gz::${url}/releases/download/release-v${pkgver}/slskr-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")

sha256sums=('57e8f77f67dcf1d855da491bdde48d1a051bb6c6e6c45995c5bf4b09523646b2'
            'c2c6a83256474f0a31d3b985289e32e1b4b37f267ea99ef000116f22227d7ed5'
            '12f8e1730347aa3d0542b3b7ab7781a9e0c6f5c60840b59b1bb614d58a661e3b')
sha256sums_x86_64=('0f581f93655725f66a302891947760d84973461322e1dc3d523a5dbb9edc325f')
sha256sums_aarch64=('30187b45b8606fdb4a018174cdf510238adedc23058be53a7217f25ae1fbf651')

package() {
  local _dir="${srcdir}/slskr-v${pkgver}-${CARCH}-unknown-linux-gnu"

  install -Dm755 "${_dir}/slskr" "${pkgdir}/usr/bin/slskr"

  install -Dm644 "${_dir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname%-bin}/LICENSE"
  install -Dm644 "${_dir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname%-bin}/README.md"
  install -Dm644 "${_dir}/docs/slskr.config.example.toml" \
    "${pkgdir}/etc/${pkgname%-bin}/config.toml"

  install -d "${pkgdir}/usr/share/${pkgname%-bin}/web"
  cp -a "${_dir}/web/build" "${pkgdir}/usr/share/${pkgname%-bin}/web/build"

  install -Dm644 "${srcdir}/${pkgname%-bin}.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname%-bin}.service"
  install -Dm644 "${srcdir}/${pkgname%-bin}.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/${pkgname%-bin}.conf"
  install -Dm644 "${srcdir}/${pkgname%-bin}.tmpfiles" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname%-bin}.conf"
}
